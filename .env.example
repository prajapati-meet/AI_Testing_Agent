# ===================================================================
# AI Test Agent - Environment Variables Example
# Copy this file to .env and populate with your local values.
# NEVER commit your real .env file to version control.
# ===================================================================

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# JWT Authentication Configuration
JWT_SECRET=replace_with_a_secure_256_bit_base64_encoded_secret_key

# AI / LLM Configuration (Used in future Test & Bug Analysis phases)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Demo Target Application Configuration
BUG_MODE=false
