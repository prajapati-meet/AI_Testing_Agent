# ===================================================================
# AI Test Agent - Environment Variables Configuration
# Copy this file to .env before running with Docker Compose:
#   cp .env.example .env
# ===================================================================

# PostgreSQL Database Configuration
# When using Docker Compose, the database host is automatically set to "postgres"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Service Discovery (Eureka Server)
# In Docker, internal services resolve via http://service-registry:8761/eureka/
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Security & JWT Token Signing Key (Min 256 bits)
JWT_SECRET=default_dev_jwt_secret_key_for_local_testing_only_32_bytes

# AI / LLM Integration (OpenAI or Gemini)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Demo Target Application (Port 3000)
# Set to 'true' to simulate intentional login & checkout failures for AI bug reporting
BUG_MODE=false
